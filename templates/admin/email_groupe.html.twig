{% extends 'base.html.twig' %}

{% block title %}Email groupé{% endblock %}

{% block body %}
<div class="card" style="max-width: 600px; margin: auto;">
    <div class="card-header">
        <h5 class="mb-0"><i class="bi bi-envelope-fill me-2"></i> Envoyer un email à tous les membres</h5>
    </div>
    <div class="card-body">
        {% for message in app.flashes('success') %}
            <div class="alert alert-success">{{ message }}</div>
        {% endfor %}

        <form method="POST">
            <div class="mb-3">
                <label class="form-label">Sujet</label>
                <input type="text" name="sujet" class="form-control" required>
            </div>
            <div class="mb-3">
                <label class="form-label">Message</label>
                <textarea name="contenu" class="form-control" rows="6" required></textarea>
            </div>
            <button type="submit" class="btn btn-primary">
                <i class="bi bi-send"></i> Envoyer à tous les membres
            </button>
        </form>
    </div>
</div>
{% endblock %}